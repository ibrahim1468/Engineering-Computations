import numpy as np
import pandas as pd

data = {
    "Substance": ["water", "blood", "seawater", "gasoline", "ethyle alcohol", "mmercury", "wood", "gold", "bones", "ice", "air"],
    "SG": [1.0, 1.05, 1.025, 0.7, 0.79, 13.6, 0.6, 19.2, 1.85, 0.92, 0.0013]
}

df = pd.DataFrame(data)
df["Density"] = df["SG"] * 1000
df["Floats"] = df["SG"] < 1

while True:
    try:
        mass = float(input("Mass (Kg): "))
        volume = float(input("Volume (m^3): "))

        if mass <= 0 or volume <= 0:
            print("Physically invalid values. Try again")
            
        density = mass/volume

        idx = (df["Density"] - density).abs().idxmin()
        best_match = df.loc[idx]
        print(f"The closest material is {best_match['Substance']} with a density of {best_match['Density']} and a percentage error of {abs(density - best_match['Density']) / best_match['Density'] * 100:.2f}%")
        break
        
    except ValueError:
        print("Only numeric values allowed")

